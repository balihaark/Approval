# Approvals frontend — copy to frontend/.env.local (gitignored).

# Where /login sends the user when their session cookie is missing/expired.
# Approvals is entered via bpi-main's workspace launcher: user signs in there,
# clicks the Approvals tile, and bpi-main hands off a per-app JWT to
# /sso/callback on this origin. Login-Auth cannot redirect back to approvals
# directly — this URL points at bpi-main so /login can guide the user there.
NEXT_PUBLIC_BPI_MAIN_URL=http://localhost:3000

# Approvals backend base URL. In dev the Next dev-proxy usually rewrites /api
# to http://localhost:3001, so /api is fine; in prod set the full origin.
NEXT_PUBLIC_API_URL=/api
