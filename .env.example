# =============================================================================
# Copy this file to BOTH:
#   .env              (repo root)
#   backend/.env      (backend — must match root for backend vars)
#
# Full guide: docs/ENV_SETUP.md
# Never commit real .env files to git.
# =============================================================================

# --- Database ---
# Default after scripts/setup-postgres.ps1 (local Postgres). Change only if your DB differs.
DATABASE_URL=postgresql://approvals:approvals@localhost:5432/approvals

# --- Backend ---
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# See docs/ENV_SETUP.md Part 1
JWT_SECRET=change-me-to-a-long-random-string

# --- Login-Auth SSO (optional; local login remains available until enabled) ---
# Must match Login-Auth's JWT_SECRET while using the current HS256 integration.
LOGIN_AUTH_JWT_SECRET=change-me-to-the-login-auth-jwt-secret
LOGIN_AUTH_ISSUER=
LOGIN_AUTH_AUDIENCE=

# Session length in seconds (default 12 hours)
# SESSION_MAX_AGE_SECONDS=43200

# Optional extra CORS origin (LAN IP, etc.)
# CORS_ORIGIN=http://192.168.1.10:3000

# --- Gmail API (optional until you configure Google Cloud) ---
# How to get each value: docs/ENV_SETUP.md Part 2–3

# GCP → APIs & Services → Credentials → OAuth 2.0 Client (Web application)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/gmail/oauth/callback

# The Gmail inbox you monitor (sign in as this account for OAuth)
GMAIL_USER=your-monitoring-inbox@gmail.com

# From: npm run gmail:auth   OR   Admin → Gmail → Connect
GMAIL_REFRESH_TOKEN=

# GCP → Pub/Sub → topic full name, e.g. projects/my-project/topics/gmail-approvals
GMAIL_PUBSUB_TOPIC=

# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Must match ?token= on your Pub/Sub push subscription URL
GMAIL_PUSH_TOKEN=

# Poll Gmail every N minutes. Use 1 locally if you skip Pub/Sub/ngrok.
GMAIL_RECONCILE_MINUTES=1

# Dev-only: allow POST /admin/simulate-email (always off in production)
# ALLOW_SIMULATE_EMAIL=true

# --- Frontend (copy these lines to frontend/.env.local) ---
# NEXT_PUBLIC_API_URL=/api
