generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum ApprovalState {
  REGISTERED
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum PartyRole {
  REQUESTER
  APPROVER
  PARTICIPANT
}

enum DecisionOutcome {
  APPROVED
  REJECTED
}

// Identity is owned by Login-Auth. This is only the local employee projection;
// it deliberately contains no password or MFA fields.
model Employee {
  employeeId  Int      @id
  email       String   @unique
  name        String
  role        UserRole @default(USER)
  isActive    Boolean  @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Approval {
  id             String         @id @default(uuid())
  subject        String
  body           String         @db.Text
  summary        String?
  department     String?
  project        String?
  state          ApprovalState  @default(REGISTERED)
  threadId       String         @unique
  messageId      String?
  gmailMessageId String?
  lastActivityAt DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  parties        Party[]
  decisions      Decision[]

  @@index([state])
  @@index([department])
  @@index([project])
  @@index([lastActivityAt])
  @@index([createdAt])
}

model Party {
  id         String    @id @default(uuid())
  approvalId String
  approval   Approval  @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  email      String
  name       String?
  role          PartyRole
  sequenceOrder Int?
  createdAt     DateTime  @default(now())

  @@unique([approvalId, email, role])
  @@index([email])
  @@index([role])
}

model Decision {
  id         String           @id @default(uuid())
  approvalId String
  approval   Approval         @relation(fields: [approvalId], references: [id], onDelete: Cascade)
  decision   DecisionOutcome
  reason     String?
  decidedBy  String
  decidedAt  DateTime         @default(now())

  @@index([approvalId])
}

model UnprocessedMail {
  id             String    @id @default(uuid())
  gmailMessageId String    @unique
  threadId       String?
  subject        String?
  fromAddress    String?
  snippet        String?
  reason         String
  payload        Json?
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?
  resolvedBy     String?

  @@index([resolvedAt])
}

model ProcessedMessage {
  id              String   @id @default(uuid())
  gmailMessageId  String   @unique
  messageIdHeader String?
  threadId        String
  processedAt     DateTime @default(now())

  @@index([threadId])
  @@index([messageIdHeader])
}

model GmailSyncState {
  id              String    @id @default("default")
  historyId       String?
  watchExpiry     DateTime?
  lastReconcileAt DateTime?
  updatedAt       DateTime  @updatedAt
}
